{
  "name": "dsh-memory",
  "version": "1.4.1",
  "description": "DSH 插件「记忆体」：把 DSH / Codex 的会话按天存档，设置里选工作区、开关来源、一键备份。",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "chat-archive", "memory"],
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "main": "./lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": [], "platform": "web" }
  }
}
